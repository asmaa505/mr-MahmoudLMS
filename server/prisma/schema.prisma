datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MCQ
  WRITTEN
}

model User {
  id               String           @id @default(uuid())
  name             String
  phone            String           @unique
  email            String?          @unique
  password         String
  role             Role             @default(STUDENT)
  isApproved       Boolean          @default(false)
  isBlocked        Boolean          @default(false)
  grade            String           @default("1") // "1" for 1st Sec, "2" for 2nd Sec, "3" for 3rd Sec
  parentPhone      String?                        // Parent contact phone number
  subscriptionDate DateTime         @default(now()) // Start date of subscription for weekly reports
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  deviceSessions   DeviceSession[]
  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  assignedCodes    ActivationCode[] @relation("AssignedCodes")
  lessonProgresses LessonProgress[]
  weeklyReports    WeeklyReport[]

  @@index([phone])
  @@index([email])
  @@index([role, isApproved, isBlocked])
}

model DeviceSession {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  userAgent         String?
  ipAddress         String?
  deviceName        String?   // e.g. "Chrome on Windows", "Safari on iPhone"
  refreshTokenHash  String?
  isRevoked         Boolean   @default(false)
  lastActiveAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([userId, deviceFingerprint])
  @@index([isRevoked])
}

model Course {
  id          String           @id @default(uuid())
  title       String
  description String?
  image       String?
  grade       String           // "1", "2", "3"
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationships
  chapters    Chapter[]
  enrollments Enrollment[]
  codes       ActivationCode[]

  @@index([grade, isPublished])
}

model Chapter {
  id        String     @id @default(uuid())
  title     String
  order     Int        @default(1)
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relationships
  lessons   Lesson[]
  quizzes   Quiz[]
  homeworks Homework[]

  @@index([courseId, order])
}

model Lesson {
  id               String           @id @default(uuid())
  title            String
  videoUrl         String           // Video file key or streaming URL
  duration         String?          // e.g. "45:00"
  durationSeconds  Int              @default(0)
  order            Int              @default(1)
  isFree           Boolean          @default(false)
  chapterId        String
  chapter          Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  codes            ActivationCode[]
  progressRecords  LessonProgress[]

  @@index([chapterId, order])
}

model Homework {
  id        String   @id @default(uuid())
  title     String
  pdfUrl    String   // Direct path or CDN URL to PDF file
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

model Quiz {
  id           String        @id @default(uuid())
  title        String
  duration     Int           // Duration in minutes
  passingScore Int           @default(50) // Minimum percentage score required to pass (0 - 100)
  maxAttempts  Int           @default(3)  // Maximum allowed attempts per student
  isMandatory  Boolean       @default(true)
  chapterId    String
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  questions    Question[]
  attempts     QuizAttempt[]

  @@index([chapterId])
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text          String       // Supports LaTeX physics formulas (e.g. $E=mc^2$)
  imageUrl      String?      // Physics diagram or circuit diagram
  type          QuestionType @default(MCQ)
  options       String?      // JSON string array of options: ["أ", "ب", "ج", "د"]
  correctOption Int?         // Zero-based index of correct option
  explanation   String?      // Detailed scientific physics solution explanation
  points        Int          @default(1)
  order         Int          @default(1)

  @@index([quizId, order])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Float     // Percentage score achieved (0 - 100)
  answers     String    // JSON string containing detailed student response map
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime  @default(now())

  @@index([userId, quizId])
  @@index([quizId, score])
}

model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedSeconds Int       @default(0)
  totalSeconds   Int       @default(0)
  isCompleted    Boolean   @default(false)
  lastWatchedAt  DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ActivationCode {
  id           String    @id @default(uuid())
  code         String    @unique
  courseId     String?
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isUsed       Boolean   @default(false)
  usedById     String?
  assignedToId String?
  assignedTo   User?     @relation("AssignedCodes", fields: [assignedToId], references: [id], onDelete: SetNull)
  usedAt       DateTime?
  assignedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([code])
  @@index([isUsed])
  @@index([courseId])
}

model WeeklyReport {
  id                     String    @id @default(uuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber             Int       // Week number relative to subscription date (1, 2, 3...)
  startDate              DateTime  // Start of this 7-day period
  endDate                DateTime  // End of this 7-day period
  videosWatchedCount     Int       @default(0)
  totalVideosAvailable   Int       @default(0)
  averageWatchPercentage Float     @default(0)
  examsTakenCount        Int       @default(0)
  averageExamScore       Float     @default(0)
  status                 String    @default("READY") // "READY", "SENT_STUDENT", "SENT_PARENT", "SENT_BOTH"
  summaryText            String    // Formatted Arabic report ready for WhatsApp/SMS
  sentToStudentAt        DateTime?
  sentToParentAt         DateTime?
  generatedAt            DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([userId, weekNumber])
  @@index([userId])
}
