# -----------------------------------------------------------------------------
# Physics LMS Backend Server - Environment Configuration
# Platform: Prof. Mahmoud El-Shahat Physics Platform
# -----------------------------------------------------------------------------

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL Database Connection URL (Supported via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/physics_lms_db?schema=public&connection_limit=20"

# Redis Cache & Session Storage (Essential for device restrictions & rate-limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_KEY_PREFIX="physics_lms:"

# JWT Authentication Secrets & Expiration
# Access Token: Short-lived (15 minutes) for high security
JWT_ACCESS_SECRET="physics-lms-super-secret-access-token-key-2026-el-shahat"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh Token: Longer-lived (7 days) with strict single-use rotation
JWT_REFRESH_SECRET="physics-lms-super-secret-refresh-token-key-2026-el-shahat"
JWT_REFRESH_EXPIRES_IN="7d"

# Device Restriction Enforcement Policy
# Options:
#  - "REPLACE": Automatically terminates previous device session when logging in on a new device.
#  - "BLOCK": Blocks login attempts from unrecognized devices until admin/teacher approves reset.
DEVICE_RESTRICTION_MODE="REPLACE"
MAX_ALLOWED_DEVICES=1
SESSION_INACTIVITY_TIMEOUT_SECONDS=86400

# Video Streaming Protection & Signed URLs
# Cryptographic secret key used for HMAC-SHA256 signature verification on video streams
STREAM_SECRET_KEY="physics-secure-stream-hmac-key-2026-shahat-physics"
SIGNED_URL_EXPIRATION_SECONDS=7200
VIDEO_STORAGE_PATH="d:/Desktop/MR-Mahmoud/public/uploads/videos"

# Rate Limiting Parameters
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
